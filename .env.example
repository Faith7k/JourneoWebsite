# Copy to .env.local and fill in real values

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Comma-separated admin emails
ADMIN_EMAILS=admin@journeo.ai

# Public site URL
NEXT_PUBLIC_SITE_URL=https://journeo.ai

# Store URLs
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/journeo
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.journeo.app

# Contact Form Email Settings (Destinatary: hello@journeo.ai)
CONTACT_EMAIL_TO=hello@journeo.ai

# Option A: Hostinger SMTP (Recommended)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@journeo.ai
SMTP_PASS=YOUR_EMAIL_PASSWORD
SMTP_FROM="Journeo İletişim Formu <hello@journeo.ai>"

# Option B: Resend API Key
# RESEND_API_KEY=re_YOUR_RESEND_KEY

# Admin dashboard — mirror of the backend's GOOGLE_PLACES_MONTHLY_BUDGET
# (Journeo-App config.py, default 2000). Only draws the budget gauge; the
# gate itself lives in the backend. Keep the two in sync.
GOOGLE_PLACES_MONTHLY_BUDGET=2000
